# IA/.env.example — copy to .env and fill in real values

# Required
API_SECRET=your-api-secret-here
JWT_SECRET=your-jwt-secret-at-least-32-chars-with-8-distinct
AI_KEY=your-ai-provider-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/ia

# AI Provider (groq, ollama, deepseek, openai)
MODEL_PROVIDER=groq
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
AI_MODE=single

# FAISS thresholds
FAISS_THRESHOLD_LOOKUP=0.54
FAISS_THRESHOLD_EXPLORATORY=0.649
FAISS_LOG_SCORES=true
FAISS_SCORE_LOG_PATH=data/faiss_scores.log

# Intent cache
INTENT_CACHE_MAX_SIZE=1000
INTENT_CACHE_TTL=300
INTENT_CACHE_LOG_HITS=true

# Memory analytics
MEMORY_ANALYTICS_ENABLED=true
MEMORY_ANALYTICS_FORMAT=csv
MEMORY_ANALYTICS_PATH=data/memory_analytics.csv

# App environment
APP_ENV=development

# Optional: Admin auto-seed (development only)
IA_AUTO_SEED_MAIN_ADMIN=false
IA_AUTO_SEED_MAIN_ADMIN_USERNAME=admin
IA_AUTO_SEED_MAIN_ADMIN_PASSWORD=your-admin-password-here
